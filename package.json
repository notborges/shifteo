{
  "name": "shifteo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/copy-licenses.mjs && node scripts/generate-sitemap.mjs",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint .",
    "licenses": "node scripts/copy-licenses.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "audit:seo": "npx lighthouse http://localhost:4173 --only-categories=performance,seo --quiet --chrome-flags=\"--headless\""
  },
  "dependencies": {
    "@jsquash/avif": "latest",
    "@jsquash/jpeg": "latest",
    "@jsquash/oxipng": "latest",
    "@jsquash/png": "latest",
    "@jsquash/resize": "latest",
    "@jsquash/webp": "latest",
    "@pdfme/pdf-lib": "latest",
    "comlink": "latest",
    "idb": "latest",
    "jszip": "^3.10.1",
    "lucide-vue-next": "latest",
    "mammoth": "latest",
    "pdfjs-dist": "latest",
    "pinia": "latest",
    "vue": "latest",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/vite": "latest",
    "@vitejs/plugin-vue": "latest",
    "@vitest/ui": "latest",
    "autoprefixer": "latest",
    "eslint": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "latest",
    "vue-tsc": "latest",
    "workbox-build": "latest"
  }
}
