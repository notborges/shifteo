{
  "name": "shifteo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "prebuild": "bun scripts/generate-sitemap.mjs",
    "dev": "bun --bun node_modules/vite/bin/vite.js",
    "build": "bunx vue-tsc --noEmit && bun --bun node_modules/vite/bin/vite.js build",
    "preview": "bun --bun node_modules/vite/bin/vite.js preview",
    "test": "bun --bun node_modules/vitest/vitest.mjs run",
    "test:watch": "bun --bun node_modules/vitest/vitest.mjs",
    "e2e": "bun --bun node_modules/@playwright/test/cli.js test",
    "lint": "bun --bun node_modules/eslint/bin/eslint.js .",
    "sitemap": "bun scripts/generate-sitemap.mjs",
    "audit:seo": "bunx lighthouse http://localhost:4173 --only-categories=performance,seo --quiet --chrome-flags=\"--headless\""
  },
  "dependencies": {
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/jxl": "1.3.0",
    "@jsquash/oxipng": "2.3.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/resize": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "@silvia-odwyer/photon": "0.3.3",
    "icojs": "1.0.1",
    "idb": "8.0.3",
    "jszip": "3.10.1",
    "libheif-js": "1.19.8",
    "@lucide/vue": "1.34.0",
    "pinia": "4.0.3",
    "utif": "3.1.0",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-vue": "6.0.8",
    "bun-types": "1.3.14",
    "eslint": "10.9.1",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11",
    "workbox-build": "7.4.1"
  }
}
